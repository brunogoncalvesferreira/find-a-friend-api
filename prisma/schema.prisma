generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Age {
  BABY
  YOUNG
  ADULT
  SENIOR
}

enum Size {
  SMALL
  MEDIUM
  LARGE
}

enum EnergyLevel {
  LOW
  MEDIUM
  HIGH
}

enum IndependenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum Environment {
  APARTMENT
  HOUSE_BACKYARD
  HOUSE_WITHOUT_BACKYARD
  FARM_ESTATE
}

model Orgs {
  id               String   @id @default(uuid())
  name             String?
  responsible_name String
  email            String   @unique
  zip_code         String
  address          String
  whatsapp         String
  password         String
  created_at       DateTime @default(now())

  pets Pets[]

  @@map("orgs")
}

model Pets {
  id                 String            @id @default(uuid())
  name               String
  about              String
  age                String
  size               Size
  energy_level       EnergyLevel
  independence_level IndependenceLevel
  environment        Environment
  city               String
  created_at         DateTime          @default(now())
  orgs               Orgs?             @relation(fields: [orgs_id], references: [id])
  orgs_id            String?

  requirements AdoptionRequirements[]
  photos       PetsPhotos[]

  @@map("pets")
}

model PetsPhotos {
  id         String   @id @default(uuid())
  url        String
  created_at DateTime @default(now())
  pets       Pets?    @relation(fields: [pets_id], references: [id])
  pets_id    String?

  @@map("pets_photos")
}

model AdoptionRequirements {
  id           String   @id @default(uuid())
  requirements String
  created_at   DateTime @default(now())
  pets         Pets?    @relation(fields: [pets_id], references: [id])
  pets_id      String?

  @@map("adoption_requirements")
}
